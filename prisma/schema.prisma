model SalesOrderPaymentTerm {
  id            String    @id @default(uuid())
  salesOrderId  String
  paymentType   String
  advanceAmount Float     @default(0)
  balanceAmount Float     @default(0)
  creditDays    Int?
  dueDate       DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model SalesOrderAdvanceReceipt {
  id                 String    @id @default(uuid())
  salesOrderId       String
  receiptDate        DateTime
  amountReceived     Float
  paymentMode        String
  referenceNo        String?
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  verifiedBy         String?
  verificationStatus String    @default("PENDING")
  verifiedAt         DateTime?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// Lifecycle history of a Sales Order: who did what, when, with what result.
// Separate from general notes. `action` names the event (for example
// ADVANCE_RECEIPT_VERIFIED, ADVANCE_RECEIPT_REJECTED, ACCOUNTS_APPROVED);
// `result` is the outcome (VERIFIED, REJECTED, APPROVED); `fromStatus` and
// `toStatus` show the order's status around the event (equal when the event did
// not move the order, such as a rejected advance); `referenceId` points at the
// advance receipt or approval the event is about. The actor always comes from
// the signed-in user.
model SalesOrderEvent {
  id           String @id @default(uuid())
  salesOrderId String

  action      String
  result      String?
  fromStatus  String?
  toStatus    String?
  referenceId String?
  remarks     String?

  actorId String?
  actor   User?   @relation("SalesOrderEventActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([salesOrderId, occurredAt])
  @@index([actorId])
}

model QuotationEvent {
  id          String @id @default(uuid())
  quotationId String

  action     String
  fromStatus String?
  toStatus   String?
  remarks    String?

  // Set on a revision only: the amounts before and after it.
  previousTaxableAmount Float?
  newTaxableAmount      Float?
  previousTotalAmount   Float?
  newTotalAmount        Float?

  actorId String?
  actor   User?   @relation("QuotationEventActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId, occurredAt])
  @@index([actorId])
}

model AccountsCommercialApproval {
  id           String  @id @default(uuid())
  salesOrderId String
  approvedBy   String
  remarks      String?
  status       String  @default("APPROVED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model DispatchOrderItem {
  id String @id @default(uuid())

  dispatchOrderId String

  inventoryItemId String?

  productCode String?
  productName String?

  description String?

  quantity Float

  uom String?

  // ==========================================
  // Pricing
  // ==========================================

  unitPrice      Float?
  discountAmount Float? @default(0)
  taxableAmount  Float? @default(0)
  gstAmount      Float? @default(0)
  totalAmount    Float? @default(0)

  // ==========================================
  // Warehouse & Inventory
  // ==========================================

  reservedQty   Float @default(0)
  pickedQty     Float @default(0)
  packedQty     Float @default(0)
  dispatchedQty Float @default(0)

  warehouseId String?
  binLocation String?

  // ==========================================
  // Traceability
  // ==========================================

  serialNumber String?
  batchNumber  String?

  // ==========================================
  // Workflow Status
  // ==========================================

  isReserved   Boolean @default(false)
  isPicked     Boolean @default(false)
  isPacked     Boolean @default(false)
  isDispatched Boolean @default(false)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id])
}

model DocumentNumberSeries {
  id String @id @default(uuid())

  companyId String?

  branchId String?

  gstRegistrationId String?

  module String

  documentType String

  documentCode String?
  format       String? @default("{PREFIX}/{DOC}/{FY}/{SEQ}")

  seriesName String

  prefix String?

  suffix String?

  separator String @default("/")

  financialYearFormat String?

  resetPolicy String @default("FINANCIAL_YEAR")

  currentNumber Int @default(0)

  startingNumber Int @default(1)

  padding Int @default(6)

  isManual Boolean @default(false)

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// The last number issued in one numbering series: a document type, a scope (a
// seller GST registration id, or "COMPANY") and an Indian financial year
// ("2026-27"). Numbers are taken inside the transaction that creates the
// document (see document-numbering.ts), so they are consecutive with no gaps:
// a document that is not created gives its number back.
model DocumentNumberCounter {
  id            String   @id @default(uuid())
  documentType  String
  scopeKey      String
  financialYear String
  lastNumber    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([documentType, scopeKey, financialYear])
}

// ==========================================================
// INVENTORY ENGINE V2
// BATCH 1 — WAREHOUSE / LOCATION / INVENTORY BALANCE
// ==========================================================

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones            WarehouseZone[]
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  SpareConsumption SpareConsumption[]
}

model WarehouseZone {
  id          String   @id @default(uuid())
  warehouseId String
  code        String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  racks     WarehouseRack[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model WarehouseRack {
  id              String   @id @default(uuid())
  warehouseZoneId String
  code            String
  name            String
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouseZone WarehouseZone  @relation(fields: [warehouseZoneId], references: [id])
  bins          WarehouseBin[]

  @@unique([warehouseZoneId, code])
  @@index([warehouseZoneId])
}

model WarehouseBin {
  id              String   @id @default(uuid())
  warehouseRackId String
  code            String
  name            String
  status          String   @default("ACTIVE")
  capacityQty     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouseRack WarehouseRack      @relation(fields: [warehouseRackId], references: [id])
  balances      InventoryBalance[]

  movementsFrom    InventoryMovement[] @relation("MovementFromBin")
  movementsTo      InventoryMovement[] @relation("MovementToBin")
  SpareConsumption SpareConsumption[]

  @@unique([warehouseRackId, code])
  @@index([warehouseRackId])
}

model InventoryBalance {
  id String @id @default(uuid())

  inventoryItemId String
  warehouseId     String
  warehouseBinId  String?

  batchId  String?
  serialId String?

  quantityOnHand    Float @default(0)
  quantityReserved  Float @default(0)
  quantityAvailable Float @default(0)
  quantityBlocked   Float @default(0)
  quantityDamaged   Float @default(0)

  averageUnitCost Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  warehouseBin  WarehouseBin? @relation(fields: [warehouseBinId], references: [id])

  batch  InventoryBatch?  @relation(fields: [batchId], references: [id])
  serial InventorySerial? @relation(fields: [serialId], references: [id])

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([warehouseBinId])
  @@index([batchId])
  @@index([serialId])
}

// ==========================================================
// INVENTORY ENGINE V2
// BATCH 2 — BATCH & SERIAL TRACEABILITY
// ==========================================================

model InventoryBatch {
  id                String    @id @default(uuid())
  inventoryItemId   String
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  supplierBatchNo   String?
  unitCost          Float     @default(0)
  quantityReceived  Float     @default(0)
  status            String    @default("ACTIVE")
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  serials       InventorySerial[]
  balances      InventoryBalance[]

  @@unique([inventoryItemId, batchNumber])
  @@index([inventoryItemId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
}

model InventorySerial {
  id              String    @id @default(uuid())
  inventoryItemId String
  batchId         String?
  serialNumber    String    @unique
  status          String    @default("IN_STOCK")
  receivedDate    DateTime?
  issuedDate      DateTime?
  warrantyStart   DateTime?
  warrantyEnd     DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  batch         InventoryBatch?    @relation(fields: [batchId], references: [id])
  balances      InventoryBalance[]

  @@index([inventoryItemId])
  @@index([batchId])
  @@index([status])
}

// ==========================================================
// INVENTORY ENGINE V2
// BATCH 3 — INVENTORY MOVEMENT
// ==========================================================

model InventoryMovement {
  id String @id @default(uuid())

  // ==========================================================
  // Movement
  // ==========================================================

  movementType   String
  movementStatus String @default("POSTED")

  // ==========================================================
  // Inventory
  // ==========================================================

  inventoryItemId String

  warehouseId String?

  sourceBinId      String?
  destinationBinId String?

  // ==========================================================
  // Traceability
  // ==========================================================

  batchId  String?
  serialId String?

  // ==========================================================
  // Quantity / Cost
  // ==========================================================

  quantity Float

  unitCost  Float?
  totalCost Float?

  // ==========================================================
  // Reference
  // ==========================================================

  referenceModule String?
  referenceId     String?

  // ==========================================================
  // Audit
  // ==========================================================

  remarks String?

  createdBy String?

  createdAt DateTime @default(now())

  // ==========================================================
  // Relations
  // ==========================================================

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  sourceBin WarehouseBin? @relation("MovementFromBin", fields: [sourceBinId], references: [id])

  destinationBin WarehouseBin? @relation("MovementToBin", fields: [destinationBinId], references: [id])

  // ==========================================================
  // Indexes
  // ==========================================================

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([sourceBinId])
  @@index([destinationBinId])
  @@index([batchId])
  @@index([serialId])
  @@index([movementType])
  @@index([referenceModule, referenceId])
  @@index([createdAt])
}

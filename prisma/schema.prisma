  opportunities    Opportunity[]

  @@index([deactivatedById])
}

// One row per lifecycle event of a Customer. "changes" is set on an edit only:
// { field: { from, to } } for each field that changed.
model CustomerEvent {
  id         String @id @default(uuid())
  customerId String

  action     String
  fromStatus String?
  toStatus   String?
  remarks    String?
  changes    Json?

  // Set on an event about one GST registration of the customer.
  gstRegistrationId String?
  gstRegistration   CustomerGSTRegistration? @relation(fields: [gstRegistrationId], references: [id])

  // Set on an event about an opportunity being linked to or unlinked from the customer.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  actorId String?
  actor   User?   @relation("CustomerEventActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, occurredAt])
  @@index([gstRegistrationId])
  @@index([opportunityId])
  @@index([actorId])
}


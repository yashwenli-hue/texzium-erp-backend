generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  FULL_ADVANCE
  PARTIAL_ADVANCE
  CREDIT
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  RTGS
  NEFT
  IMPS
  UPI
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  UNDER_REVIEW
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WarrantyPolicyType {
  NONE
  INVOICE_BASED
  INSTALLATION_BASED
}

model User {
  id                        String            @id @default(uuid())
  employeeCode              String?           @unique
  fullName                  String
  email                     String            @unique
  phone                     String?           @unique
  passwordHash              String
  status                    UserStatus        @default(ACTIVE)
  assignedWhatsAppInquiries WhatsAppInquiry[]
  roleId                    String
  role                      Role              @relation(fields: [roleId], references: [id])
  productTags               ProductTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs          AuditLog[]
  notifications      Notification[]
  assignedLeads      Lead[]
  completedFollowups LeadFollowup[] @relation("LeadFollowupCompletedBy")
  leadActivities     LeadTimeline[] @relation("LeadTimelineActor")
  deactivatedLeads   Lead[]         @relation("LeadDeactivatedBy")
  salesOrderEvents   SalesOrderEvent[] @relation("SalesOrderEventActor")
  quotationEvents    QuotationEvent[]  @relation("QuotationEventActor")
  proformaEvents     ProformaEvent[]   @relation("ProformaEventActor")
  deactivatedCustomers Customer[]      @relation("CustomerDeactivatedBy")
  customerEvents     CustomerEvent[]   @relation("CustomerEventActor")
  paymentCollectionsRecorded PaymentCollection[]      @relation("PaymentCollectionRecordedBy")
  paymentCollectionEvents    PaymentCollectionEvent[] @relation("PaymentCollectionEventActor")
  dataDeletions              DataDeletionRecord[]     @relation("DataDeletionActor")
  dataDeletionsRestored      DataDeletionRecord[]     @relation("DataDeletionRestorer")
  dataDeletionsPurged        DataDeletionRecord[]     @relation("DataDeletionPurger")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  WhatsAppDepartmentRoute WhatsAppDepartmentRoute[]
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  module String

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model AuditLog {
  id       String  @id @default(uuid())
  userId   String
  action   String
  module   String
  recordId String?
  oldData  Json?
  newData  Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// The tombstone of a record that was deleted through the governed deletion path (one
// model for every entity type: a lead and a customer today).
//
// A row is written in the same transaction that removes the record, and holds a
// complete copy of it (the row and everything that was removed with it), so what was
// deleted, by whom, when and why can always be answered, and the record can be put
// back (restore) until the recovery window ends. Nothing refers to it and it refers
// to nothing but the people who acted: entityId and survivorId are the ORIGINAL ids
// of records that may no longer exist, so they are plain columns, not foreign keys.
//
// Lifecycle (status): DELETED -> RESTORED (the record was put back) or PURGED (erased for
// good: by an administrator at any time, or automatically once the recovery window has
// ended). Both are final. The deadline is stored (purgeAfter = deletedAt + the recovery
// policy of the day, 30 days at first), not calculated, so a later change of policy never
// moves an old deadline; the record is restorable while now <= purgeAfter. A database
// trigger allows exactly those two transitions and refuses every other UPDATE, every
// DELETE and TRUNCATE (manual migration 20261011_crm_data_deletion_record.sql).
//
// The snapshot is the full record, personal data included: it is readable only through
// the endpoints guarded by governance.deletions.view. A purge keeps only a minimal audit
// entry: the snapshot, the impact, the free-text reason, the name, the code, the ORIGINAL
// record id, the survivor and the deleter are all erased (null) in the same update, and the
// database refuses a purge that keeps any of them. What stays is the tombstone's own id, the
// entity type, the reason code (a fixed category), the dates, and how and by whom it was purged.
model DataDeletionRecord {
  id String @id @default(uuid())

  // 'LEAD' | 'CUSTOMER' (checked in the database)
  entityType  String
  // The id of the lead or customer: erased (null) once it is purged, so nothing points back to it.
  // The tombstone's own `id` is the audit key.
  entityId    String?
  entityCode  String?
  // Erased (null) once the record is purged: nothing that identifies it is kept.
  entityLabel String?

  // DUPLICATE | ENTERED_IN_ERROR | TEST_DATA | JUNK_OR_SPAM | OTHER (checked in
  // the database), and the person's own explanation (1 to 500 characters).
  reasonCode String
  reason     String?

  // Set only for DUPLICATE, when the surviving record was named.
  survivorId    String?
  survivorLabel String?

  // The record and everything removed with it, as it was just before deletion, and
  // what the deletion removed and checked.
  snapshot Json
  impact   Json

  // DELETED | RESTORED | PURGED (checked in the database)
  status      String   @default("DELETED")
  deletedById String?
  deletedBy   User?    @relation("DataDeletionActor", fields: [deletedById], references: [id])
  deletedAt   DateTime @default(now())

  // The end of the recovery window. After it the record can no longer be restored.
  purgeAfter DateTime

  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("DataDeletionRestorer", fields: [restoredById], references: [id])

  purgedAt   DateTime?
  purgedById String?
  purgedBy   User?     @relation("DataDeletionPurger", fields: [purgedById], references: [id])

  // MANUAL (an administrator, purgedById = who, at any time) or AUTOMATIC (the purge worker,
  // strictly after purgeAfter, purgedById null). Set only when status is PURGED (checked in
  // the database).
  purgeMethod String?

  @@index([entityType, entityId])
  @@index([status, deletedAt])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([restoredById])
  @@index([purgedById])
}

model Notification {
  id String @id @default(uuid())

  userId  String?
  title   String
  message String

  channel  String
  category String
  priority String
  status   String

  referenceType String?
  referenceId   String?

  escalationLevel Int @default(0)
  retryCount      Int @default(0)

  isRead Boolean   @default(false)
  readAt DateTime?

  scheduledAt DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  errorMessage String?

  metadata Json?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Workflow {
  id          String  @id @default(uuid())
  module      String
  name        String
  description String?

  createdAt DateTime @default(now())
}

model Approval {
  id          String  @id @default(uuid())
  module      String
  referenceId String
  level       Int
  approvedBy  String?
  status      String

  createdAt DateTime @default(now())
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  PRE_SALES_ASSIGNED
  SALES_ASSIGNED
  REJECTED
}

model LeadSource {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id String @id @default(uuid())

  leadCode       String? @unique
  customerName   String
  companyName    String?
  email          String?
  phone          String
  alternatePhone String?

  sourceId String
  source   LeadSource @relation(fields: [sourceId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // Where the lead is. All three are null when nothing was recorded (every lead
  // that existed before location was kept, and leads that arrive from the
  // WhatsApp bot or a webhook); nothing is inferred from the phone number.
  //   country  ISO 3166-1 alpha-2 code; "IN" means domestic
  //   state    a state or union territory of India, only when country is "IN"
  //   city     free text: the city or the specific location
  // The rules are in lead-location.ts and the database enforces the shape with
  // a CHECK (manual migration 20261010_crm_lead_location.sql).
  country String?
  state   String?
  city    String?

  status LeadStatus @default(NEW)

  // Soft lifecycle. An inactive lead is hidden from normal lists and takes no
  // sales writes. The deactivated* fields describe the CURRENT deactivation and
  // are cleared on reactivation; the permanent history is in LeadTimeline
  // (LEAD_DEACTIVATED / LEAD_REACTIVATED).
  isActive           Boolean   @default(true)
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("LeadDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivationReason String?

  notes     LeadNote[]
  timelines LeadTimeline[]
  followups LeadFollowup[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([deactivatedById])
}

model LeadNote {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  note String

  createdAt DateTime @default(now())
}

// SYSTEM rows are lifecycle events written by trusted backend workflows
// (action = LEAD_CREATED, PRE_SALES_ASSIGNED, FOLLOWUP_COMPLETED, ...). A
// lifecycle event performed by a signed-in user (LEAD_DEACTIVATED,
// LEAD_REACTIVATED) is still SYSTEM, with actorId set to that user.
// EMPLOYEE rows are sales work logged by a user (action = ACTIVITY_<type>);
// they always carry activityType and actorId, set server-side only.
enum LeadTimelineSource {
  SYSTEM
  EMPLOYEE
}

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  WHATSAPP
  REQUIREMENT
  OTHER
}

model LeadTimeline {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  action  String
  remarks String?

  // What the person who performed the action wrote about it: the optional remark
  // on OPPORTUNITY_STAGE_CHANGED and LEAD_UNASSIGNED, and the required reason on
  // LEAD_REJECTED. Kept apart from `remarks`, which is the system's own sentence
  // about the event. Null on every row recorded before it existed (an older
  // LEAD_REJECTED row keeps its reason in `remarks`), and whenever the person
  // wrote nothing. Never written from client-supplied actor data: the actor is the
  // authenticated user.
  userRemark String?

  source       LeadTimelineSource @default(SYSTEM)
  activityType LeadActivityType?
  actorId      String?
  actor        User?              @relation("LeadTimelineActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
  @@index([actorId])
}

enum LeadFollowupStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model LeadFollowup {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  followupDate DateTime
  remarks      String?

  status        LeadFollowupStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?

  completedBy User? @relation("LeadFollowupCompletedBy", fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConnectorType {
  API
  WEBHOOK
  CSV
  MANUAL
}

enum ConnectorStatus {
  ACTIVE
  INACTIVE
  FAILED
}

model Connector {
  id String @id @default(uuid())

  name          String
  platform      String
  connectorType ConnectorType
  baseUrl       String?
  apiKey        String?
  apiSecret     String?
  webhookUrl    String?
  syncFrequency String?

  status ConnectorStatus @default(ACTIVE)

  mappings ConnectorMapping[]
  logs     ConnectorLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConnectorMapping {
  id String @id @default(uuid())

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id])

  sourceField String
  targetField String

  createdAt DateTime @default(now())
}

model ConnectorLog {
  id String @id @default(uuid())

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id])

  action   String
  status   String
  payload  Json?
  response Json?

  createdAt DateTime @default(now())
}

model Opportunity {
  id                String      @id @default(uuid())
  opportunityCode   String?
  leadId            String
  title             String
  expectedValue     Float
  probability       Int
  expectedCloseDate DateTime
  status            String      @default("QUALIFIED")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  quotations        Quotation[]

  // The customer this deal is for. Set explicitly (never back-filled), by
  // linking a customer to the opportunity; it cannot change once a quotation
  // exists. Every document further down the chain gets its customer from here.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  customerEvents CustomerEvent[]

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([customerId])
}

model Quotation {
  id               String            @id @default(uuid())
  quotationCode    String?
  opportunityId    String
  quoteDate        DateTime
  totalAmount      Float
  status           String            @default("DRAFT")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salesOrders      SalesOrder[]
  proformaInvoices ProformaInvoice[]
  sellerGstId      String?
  buyerGstId       String?
  placeOfSupply    String?
  taxType          String?

  taxableAmount Float @default(0)
  gstPercent    Float @default(0)
  gstAmount     Float @default(0)

  opportunity Opportunity       @relation(fields: [opportunityId], references: [id])
  events      QuotationEvent[]
}

model SalesOrder {
  id             String          @id @default(uuid())
  salesOrderCode String?
  orderDate      DateTime
  totalAmount    Float
  status         String          @default("OPEN")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productTags    ProductTag[]
  dispatchOrders DispatchOrder[]
  sellerGstId    String?
  buyerGstId     String?
  placeOfSupply  String?
  taxType        String?

  // NEW PRODUCT LINK
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  inspections          StockInspection[]
  reservations         InventoryReservation[]
  proformaInvoiceId    String?
  proformaInvoice      ProformaInvoice?       @relation(fields: [proformaInvoiceId], references: [id])
  dispatches           Dispatch[]
  Quotation            Quotation?             @relation(fields: [quotationId], references: [id])
  quotationId          String?
  purchaseRequisitions PurchaseRequisition[]
  salesInvoices        SalesInvoice[]

  paymentTerms        SalesOrderPaymentTerm[]
  advanceReceipts     SalesOrderAdvanceReceipt[]
  commercialApprovals AccountsCommercialApproval[]
  events              SalesOrderEvent[]
}

model InventoryItem {
  id           String   @id @default(uuid())
  sku          String   @unique
  productName  String
  category     String?
  hsnMasterId  String?
  stockQty     Float
  reservedQty  Float    @default(0)
  availableQty Float
  warehouse    String?
  condition    String   @default("GOOD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspections          StockInspection[]
  reservations         InventoryReservation[]
  purchaseRequisitions PurchaseRequisition[]
  spareConsumptions    SpareConsumption[]

  warrantyApplicable Boolean            @default(false)
  warrantyPolicyType WarrantyPolicyType @default(NONE)
  warrantyMonths     Int?

  salesOrders      SalesOrder[]
  WarehousePutaway WarehousePutaway[]
  productTags      ProductTag[]

  transactions InventoryTransaction[]
  balances     InventoryBalance[]

  batches InventoryBatch[]
  serials InventorySerial[]

  movements InventoryMovement[]

  hsnMaster HSNMaster? @relation(fields: [hsnMasterId], references: [id])
}

model InventoryTransaction {
  id String @id @default(uuid())

  inventoryItemId String

  warehouseId String?

  binLocation String?

  transactionType String

  referenceModule String?

  referenceId String?

  quantity Float

  balanceAfter Float?

  remarks String?

  createdBy String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model StockInspection {
  id              String         @id @default(uuid())
  inventoryItemId String
  salesOrderId    String
  inspectionDate  DateTime
  conditionStatus String
  remarks         String?
  createdAt       DateTime       @default(now())
  treatmentJobs   TreatmentJob[]

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
}

model TreatmentJob {
  id                String        @id @default(uuid())
  stockInspectionId String
  jobType           String
  assignedTo        String?
  status            String        @default("PENDING")
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  qcClearances      QCClearance[]

  stockInspection StockInspection @relation(fields: [stockInspectionId], references: [id])
}

model QCClearance {
  id             String   @id @default(uuid())
  treatmentJobId String
  qcDate         DateTime
  qcStatus       String
  remarks        String?
  createdAt      DateTime @default(now())

  treatmentJob TreatmentJob @relation(fields: [treatmentJobId], references: [id])
}

model InventoryReservation {
  id              String    @id @default(uuid())
  inventoryItemId String
  salesOrderId    String
  quantity        Float
  status          String    @default("RESERVED")
  createdAt       DateTime  @default(now())
  reservedById    String?
  reservationType String    @default("SALES_ORDER")
  expiryDate      DateTime?
  priorityLevel   String    @default("NORMAL")
  remarks         String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
}

model Dispatch {
  id             String     @id @default(uuid())
  salesOrderId   String
  dispatchDate   DateTime
  vehicleNumber  String?
  driverName     String?
  trackingNumber String?
  status         String     @default("PLANNED")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deliveries     Delivery[]

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Delivery {
  id              String   @id @default(uuid())
  dispatchId      String
  deliveryDate    DateTime
  receivedBy      String?
  deliveryStatus  String   @default("DELIVERED")
  proofOfDelivery String?
  remarks         String?
  createdAt       DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id])
}

model ProformaInvoice {
  id             String       @id @default(uuid())
  quotationId    String
  proformaNumber String?
  issueDate      DateTime
  totalAmount    Float
  customerStatus String       @default("PENDING")
  validityDate   DateTime?
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  salesOrders    SalesOrder[]

  quotation Quotation        @relation(fields: [quotationId], references: [id])
  events    ProformaEvent[]
}

model ProformaEvent {
  id                String @id @default(uuid())
  proformaInvoiceId String

  action     String
  fromStatus String?
  toStatus   String?
  remarks    String?

  actorId String?
  actor   User?   @relation("ProformaEventActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])

  @@index([proformaInvoiceId, occurredAt])
  @@index([actorId])
}

model PurchaseRequisition {
  id              String          @id @default(uuid())
  salesOrderId    String
  inventoryItemId String
  requestedQty    Float
  status          String          @default("PENDING")
  remarks         String?
  createdAt       DateTime        @default(now())
  purchaseOrders  PurchaseOrder[]

  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model PurchaseOrder {
  id                    String         @id @default(uuid())
  purchaseRequisitionId String
  poNumber              String?
  orderQty              Float
  status                String         @default("OPEN")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  goodsReceipts         GoodsReceipt[]

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
}

model SalesInvoice {
  id                    String               @id @default(uuid())
  salesOrderId          String
  invoiceNumber         String?
  invoiceDate           DateTime
  taxableAmount         Float
  gstAmount             Float
  totalAmount           Float
  paymentStatus         String               @default("PENDING")
  status                String               @default("DRAFT")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  gstRegistry           GSTInvoiceRegistry[]
  receivables           AccountsReceivable[]
  warranties            Warranty[]
  assets                Asset[]
  customerLedgerEntries CustomerLedger[]
  dispatchOrderId       String?
  customerName          String?
  irnNumber             String?
  ewayBillNumber        String?
  remarks               String?
  cgstAmount            Float                @default(0)
  sgstAmount            Float                @default(0)
  igstAmount            Float                @default(0)
  creditNotes           CreditNote[]
  debitNotes            DebitNote[]

  salesOrder       SalesOrder         @relation(fields: [salesOrderId], references: [id])
  dispatchOrder    DispatchOrder?     @relation(fields: [dispatchOrderId], references: [id])
  SalesInvoiceItem SalesInvoiceItem[]
}

model GSTInvoiceRegistry {
  id                String    @id @default(uuid())
  salesInvoiceId    String
  irn               String?
  ackNumber         String?
  ackDate           DateTime?
  qrCode            String?
  signedInvoice     String?
  ewayBillNumber    String?
  vehicleNumber     String?
  transporterName   String?
  transportDistance Float?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
}

// One receivable per invoice. That rule is enforced by the database (a unique
// index on "salesInvoiceId", created by the manual migration
// 20261009_crm_payment_collection_governance.sql) and is deliberately NOT
// declared here: a @@unique would turn SalesInvoice.receivables into a single
// optional relation and change the typing of every existing reader.
model AccountsReceivable {
  id                 String              @id @default(uuid())
  salesInvoiceId     String
  dueDate            DateTime
  outstandingAmount  Float
  paidAmount         Float               @default(0)
  balanceAmount      Float
  paymentStatus      String              @default("PENDING")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentCollections PaymentCollection[]
  badDebtWriteOffs   BadDebtWriteOff[]
  paymentCollectionEvents PaymentCollectionEvent[]

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
}

// A payment received against one receivable. Written only by the RevenueOS
// collection command (PaymentCollectionsService.create), in one transaction with
// the receivable update, the customer-ledger credit and the event below.
//
// Rules the database enforces (manual migration
// 20261009_crm_payment_collection_governance.sql, not expressible here):
//   - amount > 0
//   - one reference per receivable, case-insensitively (partial unique index on
//     "accountsReceivableId", lower(btrim("referenceNumber")))
// recordedById is null on collections that were recorded before the actor was kept.
model PaymentCollection {
  id                   String   @id @default(uuid())
  accountsReceivableId String
  paymentDate          DateTime
  amount               Float
  paymentMode          String
  referenceNumber      String?
  remarks              String?
  createdAt            DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation("PaymentCollectionRecordedBy", fields: [recordedById], references: [id])

  accountsReceivable AccountsReceivable      @relation(fields: [accountsReceivableId], references: [id])
  events             PaymentCollectionEvent[]

  @@index([accountsReceivableId, paymentDate])
  @@index([recordedById])
}

// What happened to a payment collection: who did it, when, and what it did to
// the receivable. `amount`, the balances and the statuses are snapshots taken in
// the same transaction as the change, so history stays true even if the
// receivable is later changed by FinanceOS. The accounts receivable and invoice
// ids are kept here so a receivable's whole history reads without a join.
// `action` is PAYMENT_RECORDED today; it is a string so later actions fit.
model PaymentCollectionEvent {
  id                   String @id @default(uuid())
  paymentCollectionId  String
  accountsReceivableId String
  salesInvoiceId       String

  action        String
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  fromStatus    String?
  toStatus      String?
  remarks       String?

  actorId String
  actor   User   @relation("PaymentCollectionEventActor", fields: [actorId], references: [id])

  // When the event happened; createdAt is when the row was recorded.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  paymentCollection  PaymentCollection  @relation(fields: [paymentCollectionId], references: [id])
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id])

  @@index([accountsReceivableId, occurredAt])
  @@index([paymentCollectionId])
  @@index([salesInvoiceId])
  @@index([actorId])
}

